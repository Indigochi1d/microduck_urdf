<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="microduck">

  <!-- Set collision:=false for a lighter model in visualization-only setups. -->
  <xacro:arg name="collision" default="true"/>

  <xacro:include filename="$(find microduck_urdf)/urdf/microduck.xacro"/>
  <xacro:microduck collision="$(arg collision)"/>

</robot>
